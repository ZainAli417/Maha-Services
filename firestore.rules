rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function userRole() {
      // Cautiously fetch the user's role if the user doc exists to prevent crashes
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }

    function isAdmin() {
      return isAuth() && (userRole() == 'admin' || userRole() == 'Admin');
    }

    function isRecruiter() {
      // Allow capital 'R' and lowercase 'r'
      return isAuth() && (userRole() == 'Recruiter' || userRole() == 'recruiter');
    }

    function isJobSeeker() {
      return isAuth() && (userRole() == 'Job_Seeker' || userRole() == 'JobSeeker' || userRole() == 'job_seeker');
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read, write: if isUser(userId) || isAdmin();
    }

    match /admin/{adminId} {
      allow read, write: if isUser(adminId) || isAdmin();
    }

    match /recruiter/{recruiterId} {
      allow read: if isUser(recruiterId) || isAdmin();
      allow write: if isUser(recruiterId) || isAdmin();

      match /Posted_jobs/{jobId} {
        allow read, write: if isUser(recruiterId) || isAdmin();
      }
    }

    match /Posted_jobs_public/{jobId} {
      allow read: if isAuth();
      allow create: if isRecruiter() || isAdmin();
      allow update: if isAuth();
      allow delete: if isAdmin() || (isRecruiter() && resource.data.recruiterUid == request.auth.uid);
    }

    match /Job_Seeker/{jobSeekerId} {
      allow read: if isUser(jobSeekerId) || isAdmin() || isRecruiter();
      allow write: if isUser(jobSeekerId) || isAdmin();

      match /applied_jobs/{jobId} {
        allow read: if isUser(jobSeekerId) || isAdmin() || isRecruiter();
        allow write: if isUser(jobSeekerId) || isAdmin();
      }
    }

    match /applications/{userId}/{document=**} {
      allow read, write: if isUser(userId) || isAdmin();
    }

    match /recruiter_requests/{requestId} {
      allow read: if isAdmin() || (isRecruiter() && resource.data.recruiter_id == request.auth.uid);
      allow create: if isRecruiter();
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION GROUP RULES ---
    match /{path=**}/applied_jobs/{jobId} {
      // Allow recruiters to read applications specifically for THEIR jobs
      allow read: if isAuth() && (isAdmin() || (isRecruiter() && resource.data.recruiterUid == request.auth.uid));
    }
  }
}
